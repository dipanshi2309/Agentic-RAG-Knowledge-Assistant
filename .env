# Application Environment Variables
# Copy this file to .env or edit it directly.

# Google Gemini API key from Google AI Studio (required if not entered in UI)
GEMINI_API_KEY=AQ.Ab8RN6Iha2lPQUjbRaHxFDcJtnqaCONJpx9jx6qNo7ohsNB7iw

# OpenAI key (optional fallback)
OPENAI_API_KEY=

# Local development defaults (falls back to SQLite PersistentClient if host is not running)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# LLM model settings (e.g. gemini-2.5-flash, gemini-1.5-flash)
LLM_MODEL=gemini-2.5-flash

# RAG Splitting settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
